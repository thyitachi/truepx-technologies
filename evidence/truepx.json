{
  "Payload CMS": {
    "markers": [
      {
        "rule": "headers X-Powered-By: Next\\.js, Payload",
        "source": "https://github.com/payloadcms/payload/blob/96bc50e4fc91608cc04649c72de420f358cb49f7/packages/next/src/withPayload/withPayload.js#L14-L17",
        "license": "MIT"
      }
    ],
    "positive": [
      {
        "url": "https://vercel.com/",
        "checked": "2026-10-29",
        "found": "x-powered-by: Next.js, Payload"
      },
      {
        "url": "https://showandtell.agency/",
        "checked": "2026-10-29",
        "found": "x-powered-by: Next.js, Payload"
      },
      {
        "url": "https://byteklaar.be/",
        "checked": "2026-10-29",
        "found": "x-powered-by: Next.js, Payload"
      }
    ],
    "negative": [
      {
        "found": "x-powered-by: Next.js",
        "why": "Next.js's own header on a Next.js site that runs another headless CMS (https://strapi.io/): Payload's withPayload turns Next.js's header off and sends Next.js, Payload instead"
      },
      {
        "found": "x-powered-by: WordPress VIP <https://wpvip.com>",
        "why": "the same header naming another CMS host (https://techcrunch.com/)"
      }
    ]
  },
  "Phosphor Icons": {
    "markers": [
      {
        "rule": "dom link[rel~='stylesheet'][href*='@phosphor-icons/web']: href @phosphor-icons/web(?:@(\\d+(?:\\.\\d+)*)?[^/]*)?/src/\\;version:\\1",
        "source": "https://github.com/phosphor-icons/web/blob/9634e6f3bccabbc1bf2c59dc283abd283d00946d/README.md?plain=1#L57",
        "license": "MIT"
      }
    ],
    "positive": [
      {
        "url": "https://www.flowtrix.co/",
        "checked": "2026-10-29",
        "found": "<link rel=\"stylesheet\" href=\"https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css\""
      },
      {
        "url": "https://www.skyulf.com/",
        "checked": "2026-10-29",
        "found": "<link rel=\"stylesheet\" href=\"https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css\""
      },
      {
        "url": "https://www.trylotus.dev/",
        "checked": "2026-10-29",
        "found": "<link rel=\"stylesheet\" type=\"text/css\" href=\"https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css\""
      }
    ],
    "negative": [
      {
        "found": "<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css\">",
        "why": "Bootstrap Icons, another icon font loaded as a stylesheet from a versioned npm CDN path (http://www.bmds-lab.ca/): not Phosphor's @phosphor-icons/web package"
      },
      {
        "found": "<link rel=\"canonical\" href=\"https://bundlephobia.com/package/@phosphor-icons/web\" data-next-head=\"\"/>",
        "why": "a package page's canonical link, which names the package without loading it (https://bundlephobia.com/package/@phosphor-icons/web): not a stylesheet, and no /src/ path"
      },
      {
        "found": "<link rel=\"alternate\" type=\"text/markdown\" href=\"https://npm.io/package/@phosphor-icons/web.md\"/>",
        "why": "a package page's link to its Markdown copy, which names the package without loading it (https://npm.io/package/@phosphor-icons/web): not a stylesheet, and no /src/ path"
      }
    ]
  },
  "React Aria": {
    "markers": [
      {
        "rule": "dom [data-react-aria-pressable]:",
        "source": "https://github.com/adobe/react-spectrum/blob/a562b335e645c172ec5a940b3e47ccdadbeeaa15/packages/react-aria/src/interactions/usePress.ts#L186",
        "license": "Apache-2.0"
      }
    ],
    "positive": [
      {
        "url": "https://vercel.com/",
        "checked": "2026-10-29",
        "found": "<a role=\"link\" href=\"/login\" type=\"submit\" tabindex=\"0\" data-react-aria-pressable=\"true\""
      },
      {
        "url": "https://heroui.com/",
        "checked": "2026-10-29",
        "found": "data-rac=\"\" type=\"button\" tabindex=\"0\" data-react-aria-pressable=\"true\""
      },
      {
        "url": "https://intentui.com/",
        "checked": "2026-10-29",
        "found": "aria-label=\"Goto homepage\" href=\"/\" tabindex=\"0\" data-react-aria-pressable=\"true\""
      }
    ],
    "negative": [
      {
        "found": "type=\"button\" aria-haspopup=\"menu\" aria-expanded=\"false\" data-headlessui-state=\"\"",
        "why": "a menu button of Headless UI, another headless React library, with its own data attribute (https://headlessui.com/): no data-react-aria-pressable"
      },
      {
        "found": "<button aria-label=\"Open Menu\" data-scope=\"dialog\" data-part=\"trigger\" dir=\"ltr\"",
        "why": "a dialog trigger of Ark UI, which marks its parts with data-scope and data-part (https://ark-ui.com/): another headless library's button, no data-react-aria-pressable"
      }
    ]
  }
}
